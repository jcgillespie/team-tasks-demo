# Production environment variable overrides
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is excluded from source control — never commit it.

subscription_id = "<your-azure-subscription-id>"
environment     = "production"
location        = "eastus2"
name_prefix     = "tt"

github_org  = "<your-github-org-or-username>"
github_repo = "team-tasks-demo"

# AKS — production-sized node pool
aks_node_count   = 3
aks_node_vm_size = "Standard_D4s_v3"

# Networking
vnet_address_space = ["10.30.0.0/16"]
aks_subnet_cidr    = "10.30.1.0/24"

# Container Registry — Premium SKU recommended for geo-replication in production
acr_sku = "Premium"

# Key Vault
key_vault_sku = "standard"

tags = {
  environment = "production"
  project     = "team-tasks"
  managed_by  = "terraform"
}

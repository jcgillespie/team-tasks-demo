# .NET artifacts
**/bin/
**/obj/

# Node artifacts
**/node_modules/
**/dist/

# Logs and temp files
*.log
.DS_Store

# Local databases
*.db
*.db-shm
*.db-wal

# IDE and test output
.vscode/
coverage/

# Terraform state — never commit these
**/*.tfstate
**/*.tfstate.*
**/.terraform/
**/.terraform.lock.hcl

# Terraform variable files with real values — use *.tfvars.example for templates
**/terraform.tfvars
!**/*.tfvars.example

# Terraform plan outputs
**/tfplan
**/*.tfplan

# Docker credentials
.docker/

# Environment variable files with secrets
.env
.env.*
!.env.example

# Promotion audit records (generated at runtime)
.promotions/

# Azure CLI token cache
.azure/
